{
  "$schema": "../../chain.schema.json",
  "chain_name": "vertix",
  "status": "upcoming",
  "network_type": "mainnet",
  "stage": "pre-launch",
  "pretty_name": "Vertix",
  "chain_type": "cosmos",
  "chain_id": "vertix-1",
  "bech32_prefix": "vertix",
  "daemon_name": "vertixd",
  "node_home": "$HOME/.vertixd",
  "key_algos": ["secp256k1"],
