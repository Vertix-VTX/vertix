        "average_gas_price": 0.025,
        "high_gas_price": 0.04
      }
    ]
  },
  "staking": {
    "staking_tokens": [{ "denom": "uvtx" }]
  },
  "codebase": {
    "git_repo": "https://github.com/vertix-network/vertix",
