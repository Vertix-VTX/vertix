    "language": { "type": "go", "version": "1.22" }
  },
  "apis": {
    "rpc": [
      {
        "address": "https://rpc.vertix.example",
        "provider": "vertix"
      }
    ],
    "rest": [
      {
        "address": "https://lcd.vertix.example",
        "provider": "vertix"
      }
    ]
  },
  "keywords": ["rwa", "oracle"]
}
